# ==========================================
# EzzyDelivery Qatar - Django Project
# .aiexclude - AI Assistant Exclusion Rules
# Last Updated: November 13, 2025
# ==========================================
#
# Purpose: Tell AI assistants which files/folders to IGNORE
# when analyzing code or providing suggestions
#
# Why: Improves AI performance, reduces token usage,
# focuses AI on relevant project code only
# ==========================================

# ===== VIRTUAL ENVIRONMENTS =====
# Never analyze virtual environment files
venvezzy/
venvezdl/
venv/
.venv/
env/
ENV/
bin/
include/
lib/
lib64/
Scripts/
pyvenv.cfg

# ===== PYTHON CACHE & COMPILED =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/

# ===== DJANGO MIGRATIONS =====
# Exclude migrations (auto-generated by Django)
**/migrations/
**/migrations/*.py
!**/migrations/__init__.py

# ===== DJANGO STATIC & MEDIA =====
# Exclude collected static files and user uploads
static/
staticfiles/
media/
uploads/
user_files/

# Static vendor libraries (3rd party)
static/admin/
static/fontawesomefree/
static/js/vendor/
static/css/vendor/

# ===== DATABASE FILES =====
*.sqlite3
*.db
db.sqlite3
*.sql
*.dump

# ===== SENSITIVE FILES =====
# Never show credentials to AI
*creds.json
shopify_creds.json
woocommerce_creds.json
*_credentials.json
*_secrets.json
*.pem
*.key
*.token
.env
.env.*

# ===== DEPENDENCIES & NODE MODULES =====
node_modules/
package-lock.json
yarn.lock
Pipfile.lock
poetry.lock

# ===== TESTING & COVERAGE =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
coverage.xml
test-results/

# ===== IDE & EDITOR FILES =====
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.iml

# ===== OS FILES =====
.DS_Store
Thumbs.db
*.tmp
.directory

# ===== LOGS =====
*.log
*.log.*
logs/
error.log
access.log

# ===== DOCUMENTATION BUILD FILES =====
# Keep source .md files, exclude builds
docs/_build/
docs/.doctrees/
site/

# ===== BACKUP & TEMPORARY FILES =====
*.bak
*.backup
*~
*.orig
*.tmp
temp/
tmp/
backup/
backups/

# ===== LARGE DATA FILES =====
# Exclude large datasets or exports
*.csv
*.xlsx
*.json
# But INCLUDE these specific files:
!requirements.txt
!package.json
!shopify_creds.json

# ===== VERSION CONTROL =====
.git/
.github/

# ===== DEPLOYMENT FILES =====
# Exclude production deployment configs
docker-compose.prod.yml
kubernetes/
helm/
.deploy/

# ===== AI CONTEXT (if using other tools) =====
.ai-context/
.aichat/

# ===== PROJECT-SPECIFIC EXCLUDES =====
# EzzyDelivery specific files to exclude

# Test data and samples
test_data/
sample_data/
sample_orders/

# Private notes
redmi.txt
notes.txt
TODO.txt
PRIVATE_NOTES.md

# Large generated reports
reports/
analytics/
export/

# ===== WHAT TO INCLUDE (AI Should Analyze) =====
# The following should NOT be excluded:
# - Source code (.py files in apps/)
# - Templates (.html files)
# - Tests (test_*.py, *_test.py)
# - Configuration (settings.py, urls.py)
# - Documentation (.md files in docs/)
# - Requirements (requirements.txt)
# - Forms, models, views, serializers
# - API endpoints
# - Core business logic

# ===== END OF .aiexclude =====
# For project structure: docs/analysis/ARCHITECTURE.md
# For development guide: docs/VSCODE_SETUP_AND_WORKFLOW.md
