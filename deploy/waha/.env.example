# Copy to .env in this directory before running `docker compose up`.
# Mirror the same values from /home/ezzyadmin/ezdlproject/ezzydelivery/.env
# (the Django app reads them from there; this file scopes them to compose).

WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_SECRET=
# Optional: stable creds for WAHA's built-in /dashboard and / (swagger).
# If omitted, WAHA generates fresh values on every container restart.
WAHA_DASHBOARD_PASSWORD=
WAHA_SWAGGER_PASSWORD=
