# Drop these blocks into the existing /etc/nginx/sites-enabled/ezzydelivery
# server { ... } that handles ezzydelivery.qa, alongside the existing locations.
#
# IMPORTANT: ^~ on /waha/wa-dashboard/ and /waha/wa-chats/ is required so they
# win over the catch-all /waha/ proxy. Without ^~ Django ops UIs would route to
# the WAHA container and 404.
#
# Replace REPLACE_WITH_WAHA_API_KEY with the value of WAHA_API_KEY from
# /home/ezzyadmin/ezdlproject/ezzydelivery/.env (do NOT commit it here).

# Django ops UIs — htpasswd-gated, served by gunicorn.
location ^~ /waha/wa-dashboard/ {
    auth_basic           "EzzyDelivery ops";
    auth_basic_user_file /etc/nginx/.htpasswd;
    proxy_pass           http://unix:/run/gunicornezzy.sock;
    proxy_set_header     Host              $host;
    proxy_set_header     X-Real-IP         $remote_addr;
    proxy_set_header     X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header     X-Forwarded-Proto $scheme;
}
location ^~ /waha/wa-chats/ {
    auth_basic           "EzzyDelivery ops";
    auth_basic_user_file /etc/nginx/.htpasswd;
    proxy_pass           http://unix:/run/gunicornezzy.sock;
    proxy_set_header     Host              $host;
    proxy_set_header     X-Real-IP         $remote_addr;
    proxy_set_header     X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header     X-Forwarded-Proto $scheme;
}

# Catch-all WAHA reverse proxy — htpasswd-gated, X-Api-Key injected.
# QR refresh needs proxy_buffering off (server-sent updates).
location /waha/ {
    auth_basic           "EzzyDelivery ops";
    auth_basic_user_file /etc/nginx/.htpasswd;
    proxy_pass           http://127.0.0.1:3000/;
    proxy_set_header     X-Api-Key         "REPLACE_WITH_WAHA_API_KEY";
    proxy_set_header     Host              $host;
    proxy_set_header     X-Real-IP         $remote_addr;
    proxy_buffering      off;
    proxy_read_timeout   300s;
}

# WAHA webhook receiver — public, HMAC-verified by Django.
# Already routed through the default Django location, but listing here in case
# the existing location pattern is restrictive. No auth_basic — HMAC is the gate.
# (If your existing server { } already proxies /api/ to gunicorn, you can omit
#  this block — it's a no-op on top of the existing rule.)
