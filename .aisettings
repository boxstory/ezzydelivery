# ==========================================
# EzzyDelivery Qatar - Django Project
# .aisettings - AI Assistant Project Configuration
# Last Updated: November 13, 2025
# ==========================================
#
# PURPOSE: Provide AI assistants with project-specific
# context, rules, and guidelines to prevent errors
# and ensure consistent, high-quality assistance
#
# CRITICAL: This file ensures AI never uses code/context
# from other projects or global examples
# ==========================================

# ===== PROJECT IDENTITY =====
project_name: "EzzyDelivery"
project_type: "Django Web Application"
project_version: "2.0"
project_description: "Qatar Delivery Services Platform - Order Management, Delivery Tasks, Driver Coordination, E-commerce Integration"

# Target Market
country: "Qatar"
primary_city: "Doha"
language: "English (en-QA)"
future_languages: ["Arabic"]

# Tech Stack
framework: "Django 4.2+"
python_version: "3.12.7"
database: "PostgreSQL (recommended) / SQLite3 (development)"
api_framework: "Django REST Framework"
frontend: "Django Templates + HTML/CSS/JS"

# ===== CRITICAL RULES FOR AI ASSISTANTS =====

## Rule 1: PROJECT-SPECIFIC CODE ONLY
# ⚠️ NEVER use code examples from other projects
# ⚠️ NEVER use generic/template code without adaptation
# ⚠️ ALWAYS base responses on THIS project's existing code
# ✅ READ the actual files in this project before suggesting changes
# ✅ MAINTAIN consistency with existing code style
# ✅ PRESERVE existing functionality unless explicitly asked to change

## Rule 2: DOCUMENTATION FIRST
# ✅ ALWAYS read docs/ folder before answering questions
# ✅ CHECK docs/analysis/ for project architecture
# ✅ CHECK docs/security/ for security guidelines
# ✅ CHECK docs/setup/ for configuration details
# ⚠️ NEVER contradict existing documentation
# ⚠️ NEVER provide outdated or conflicting advice

## Rule 3: SECURITY AWARE
# ⚠️ NEVER suggest code with security vulnerabilities
# ⚠️ NEVER hardcode credentials or secrets
# ⚠️ NEVER disable security features without explicit warning
# ✅ READ docs/security/SECURITY_ASSESSMENT.md first
# ✅ ALWAYS validate user input
# ✅ ALWAYS use authorization checks on data access
# ✅ WARN about security implications

## Rule 4: FOLLOW PROJECT PATTERNS
# ✅ USE existing model patterns and relationships
# ✅ FOLLOW existing view structure and naming
# ✅ MAINTAIN consistent error handling
# ✅ PRESERVE existing signal patterns
# ⚠️ NEVER introduce conflicting patterns
# ⚠️ NEVER break existing integrations

## Rule 5: TEST-DRIVEN APPROACH
# ✅ ALWAYS suggest tests alongside code changes
# ✅ RUN existing tests before claiming code works
# ✅ CHECK test coverage impact
# ⚠️ NEVER suggest untested code for production
# ⚠️ NEVER break existing tests without justification

# ===== PROJECT STRUCTURE =====

# Main Django Apps
apps:
  - client          # Business/client management
  - orders          # Order management and verification
  - delivery        # Delivery task management
  - fleet           # Driver and vehicle management
  - workforce       # Staff and workforce management
  - core            # Core utilities (SEO, context processors)
  - product         # Product management
  - ezzy_api        # API endpoints and external integrations
  - webpages        # Public-facing pages

# Key Models (Reference ONLY - Read actual code for details)
critical_models:
  - Business        # Client businesses
  - Order           # Customer orders
  - DeliveryTask    # Delivery tasks
  - Driver          # Delivery drivers
  - OrderVerificationLog  # Audit trail
  - AddressVerification   # Address validation

# External Integrations (Be Careful!)
external_apis:
  - Shopify         # E-commerce platform
  - WooCommerce     # E-commerce platform
  - Shipday DMS     # Delivery management system
  - Mapbox          # Maps and geocoding
  - HERE Maps       # Alternative geocoding
  - Tookan          # Fleet management (optional)

# ===== FILE LOCATION RULES =====

# Where to save different types of files
file_locations:
  documentation: "docs/"
  analysis_reports: "docs/analysis/"
  security_docs: "docs/security/"
  setup_guides: "docs/setup/"
  user_guides: "docs/guides/"
  api_docs: "docs/api/"
  fix_tracking: "docs/critical-fixes/"

  # Source code
  app_code: "{app_name}/"
  tests: "{app_name}/tests.py"
  models: "{app_name}/models.py"
  views: "{app_name}/views.py"
  serializers: "{app_name}/serializers.py"

  # Configuration
  settings: "ezzydelivery/settings.py"
  urls: "{app_name}/urls.py"

  # Static files
  static: "static/"
  media: "media/"
  templates: "templates/"

# ===== CODING STANDARDS =====

# Python Style
python_style:
  formatter: "black"
  linter: "flake8"
  line_length: 100
  docstring_style: "Google"
  type_hints: "required for new code"

# Django Patterns
django_patterns:
  use_class_based_views: false       # This project uses function-based views
  use_signals: true                  # Heavy use of signals for automation
  use_select_related: "always for FK"
  use_prefetch_related: "always for M2M"
  authorization_required: true       # Always check permissions

# Naming Conventions
naming:
  models: "PascalCase"
  functions: "snake_case"
  constants: "UPPER_SNAKE_CASE"
  private_methods: "_leading_underscore"

# ===== COMMON PATTERNS IN THIS PROJECT =====

# Order Workflow Pattern
order_workflow: |
  1. Order created → original_order_data saved as proof
  2. Order verification → AddressVerification created
  3. Order verified → DeliveryTask auto-created via signal
  4. Task published → Pushed to DMS via API
  5. Driver assigned → Status updated → DMS notified

# Authorization Pattern
authorization_pattern: |
  # ALWAYS check user can access the object
  business = request.user.user_business.first()
  order = Order.objects.get(id=order_id, business=business)  # Filter by business!
  # NEVER just get by ID without authorization check

# Error Handling Pattern
error_handling: |
  try:
      # operation
  except SpecificException as e:
      logger.error(f"Error in function_name: {e}")
      messages.error(request, "User-friendly error message")
      return redirect('error_page')

# ===== KNOWN ISSUES & CONSTRAINTS =====

# Technical Debt (Be Aware!)
known_issues:
  - "OrderProductList uses 15 hardcoded fields (legacy pattern)"
  - "N+1 query problems in list views (needs optimization)"
  - "294 print statements need replacing with logging"
  - "Missing authorization checks in some views (CRITICAL)"
  - "Hardcoded Shopify token in orders/views.py:531 (MUST FIX)"
  - "No database indexes on frequently queried fields"

# Don't Break These!
critical_features:
  - "Order proof storage (original_order_data field)"
  - "Signal-based automatic task creation"
  - "DMS push integration"
  - "Address verification workflow"
  - "COD tracking system"
  - "Shopify/WooCommerce webhooks"

# ===== TESTING REQUIREMENTS =====

testing:
  framework: "pytest + Django TestCase"
  coverage_target: "80%"
  mock_external_apis: true
  test_signals: true
  test_authorization: "ALWAYS"

# Test Files
test_locations:
  - "orders/tests.py"
  - "delivery/tests.py"
  - "client/tests.py"
  - "ezzy_api/tests.py"

# ===== SECURITY REQUIREMENTS =====

security:
  authentication: "Django auth + session"
  authorization: "Object-level permissions required"
  csrf_protection: "enabled (never use @csrf_exempt)"
  debug_mode: "False in production"
  secure_cookies: "True in production"
  api_authentication: "Token-based for external APIs"

# Critical Security Rules
security_rules:
  - "Never expose API tokens in code"
  - "Always validate user input"
  - "Always check object ownership before access"
  - "Always use parameterized queries (ORM handles this)"
  - "Never disable CSRF without security review"
  - "Always log security-relevant events"

# ===== DEPLOYMENT CONTEXT =====

environments:
  development:
    debug: true
    database: "SQLite3"
    allowed_hosts: ["localhost", "127.0.0.1"]

  staging:
    debug: false
    database: "PostgreSQL"
    allowed_hosts: ["staging.ezzydelivery.qa"]

  production:
    debug: false
    database: "PostgreSQL"
    allowed_hosts: ["ezzydelivery.qa", "www.ezzydelivery.qa"]
    https: required
    monitoring: "enabled"

# ===== HELPFUL COMMANDS =====

# Common Django Commands
django_commands:
  check_system: "python manage.py check"
  run_tests: "python manage.py test"
  run_server: "python manage.py runserver"
  make_migrations: "python manage.py makemigrations"
  migrate: "python manage.py migrate"
  shell: "python manage.py shell"

# Development Tools
dev_tools:
  format_code: "black ."
  lint_code: "flake8 ."
  type_check: "mypy ."
  run_tests: "pytest"
  coverage: "pytest --cov=. --cov-report=html"

# ===== DOCUMENTATION REFERENCES =====

# Before suggesting changes, READ these docs:
required_reading:
  - "docs/PROJECT_COMPREHENSIVE_ANALYSIS_AND_IMPROVEMENTS.md"
  - "docs/analysis/ARCHITECTURE.md"
  - "docs/analysis/APP_ANALYSIS.md"
  - "docs/security/SECURITY_ASSESSMENT.md"
  - "docs/analysis/CODE_QUALITY.md"
  - "docs/analysis/PERFORMANCE_ANALYSIS.md"

# For specific tasks:
task_specific_docs:
  deployment: "docs/setup/DEPLOYMENT_GUIDE.md"
  installation: "docs/setup/INSTALLATION.md"
  configuration: "docs/setup/CONFIGURATION.md"
  security: "docs/security/SECURITY_ASSESSMENT.md"
  api_usage: "docs/api/API_DOCUMENTATION.md"
  workflow: "docs/VSCODE_SETUP_AND_WORKFLOW.md"

# ===== AI ASSISTANT BEHAVIOR =====

# How AI should behave
ai_behavior:
  read_before_suggest: true
  context_aware: true
  security_conscious: true
  test_driven: true
  document_changes: true

  # Never do these:
  forbidden_actions:
    - "Use code from other projects"
    - "Suggest insecure patterns"
    - "Break existing functionality"
    - "Ignore project conventions"
    - "Skip reading documentation"
    - "Hardcode secrets or credentials"
    - "Disable security features silently"
    - "Provide generic non-specific answers"

  # Always do these:
  required_actions:
    - "Read relevant project files first"
    - "Follow project patterns and conventions"
    - "Suggest tests alongside code"
    - "Warn about security implications"
    - "Reference specific file locations"
    - "Provide project-specific examples"
    - "Check documentation for conflicts"
    - "Explain reasoning behind suggestions"

# ===== RESPONSE FORMAT =====

# How AI should format responses
response_format:
  include_file_paths: true          # Always reference specific files
  include_line_numbers: true        # When pointing to specific code
  provide_examples: "project-specific"
  explain_reasoning: true
  warn_breaking_changes: true
  suggest_tests: true
  reference_docs: true

# ===== END OF .aisettings =====
